local function getInputPosition(input)
    return Vector2.new(input.Position.X, input.Position.Y)
end

local function getViewport()
    local camera = workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(800, 600)
end

local function beginESPPress(input)
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    longPressToken += 1

    local press = {
        input = input,
        isTouch = input.UserInputType == Enum.UserInputType.Touch,
        start = getInputPosition(input),
        moved = false,
        longPressed = false,
        positions = {}
    }

    for _, button in ipairs(groupButtons) do
        local p = button.AbsolutePosition
        press.positions[button] = Vector2.new(p.X, p.Y)
    end

    activePress = press
    suppressNextClick = false

    local token = longPressToken

    task.delay(HOLD_TIME, function()
        if token ~= longPressToken or activePress ~= press then
            return
        end

        if not press.moved then
            press.longPressed = true
            suppressNextClick = true
            expanded = true
            updateMenu()
        end
    end)
end

local function moveButtonGroup(press, delta)
    local viewport = getViewport()
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    for _, button in ipairs(groupButtons) do
        local p = press.positions[button]
        if p then
            minX = math.min(minX, p.X)
            minY = math.min(minY, p.Y)
            maxX = math.max(maxX, p.X + button.AbsoluteSize.X)
            maxY = math.max(maxY, p.Y + button.AbsoluteSize.Y)
        end
    end

    local lowX = -minX
    local lowY = -minY
    local highX = viewport.X - maxX
    local highY = viewport.Y - maxY

    delta = Vector2.new(
                math.clamp(delta.X, lowX, highX),
        math.clamp(delta.Y, lowY, highY)
    )

    for _, button in ipairs(groupButtons) do
        local p = press.positions[button]
        if p then
            button.Position = UDim2.fromOffset(
                p.X + delta.X,
                p.Y + delta.Y
            )
        end
    end
end

track(espButton.InputBegan:Connect(function(input)
    beginESPPress(input)
end))

track(UserInputService.InputChanged:Connect(function(input)
    local press = activePress
    if not press then return end

    if press.isTouch then
        if input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local currentPosition = getInputPosition(input)
    local delta = currentPosition - press.start

    if delta.Magnitude > MOVE_THRESHOLD then
        if not press.moved then
            press.moved = true
            longPressToken += 1
        end

        moveButtonGroup(press, delta)
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    local press = activePress
    if not press then return end

    if input == press.input
        or (press.isTouch and input.UserInputType == Enum.UserInputType.Touch)
        or (not press.isTouch and input.UserInputType == Enum.UserInputType.MouseButton1) then

        activePress = nil
        longPressToken += 1

        if press.moved or press.longPressed then
            suppressNextClick = true

            task.delay(0.35, function()
                suppressNextClick = false
            end)
        end
    end
end))

local function updateESP()
    for player, data in pairs(espObjects) do
        if not player.Parent then
            removeESP(player)
            continue
        end

        if not enabled or selectedPlayers[player] == false then
            hideESP(data)
            continue
        end

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not humanoid or not root or humanoid.Health <= 0 then
            hideESP(data)
            continue
        end

        local camera = workspace.CurrentCamera
        if not camera then
            hideESP(data)
            continue
        end

        local screenPosition, onScreen = camera:WorldToViewportPoint(root.Position)

        if not onScreen or screenPosition.Z <= 0 then
            hideESP(data)
            continue
        end

        local head = character:FindFirstChild("Head")
        local topPosition = head
            and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            or camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))

        local bottomPosition = camera:WorldToViewportPoint(
            root.Position - Vector3.new(0, 3, 0)
        )

        local ownCharacter = LP.Character
local ownRoot = ownCharacter
    and ownCharacter:FindFirstChild("HumanoidRootPart")

local distance = ownRoot
    and (ownRoot.Position - root.Position).Magnitude
    or 50

local scale = math.clamp(distance / 50, 0.85, 1.15)

local distanceScale = math.clamp(screenPosition.Z / 30, 0.65, 1.15)

local boxWidth = 15
local boxHeight = 25

data.box.Position = UDim2.fromOffset(
    screenPosition.X - boxWidth / 2,
    screenPosition.Y - boxHeight / 2
)

data.box.Size = UDim2.fromOffset(boxWidth, boxHeight)
data.box.Visible = true

        local lineStart = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
        local lineEnd = Vector2.new(screenPosition.X, screenPosition.Y)

        local difference = lineEnd - lineStart
        local length = difference.Magnitude
        local angle = math.deg(math.atan2(difference.Y, difference.X))

        data.line.Position = UDim2.fromOffset(
            (lineStart.X + lineEnd.X) / 2,
            (lineStart.Y + lineEnd.Y) / 2
        )
        data.line.Size = UDim2.fromOffset(length, 1)
        data.line.Rotation = angle
        data.line.Visible = true

        if infoEnabled then
            data.info.Position = UDim2.fromOffset(
                screenPosition.X + boxWidth / 2 + 5,
                screenPosition.Y - 38
            )
            data.info.Visible = true

            data.displayName.Text = player.DisplayName
            data.username.Text = "@" .. player.Name
            data.hp.Text = "HP: " .. math.floor(humanoid.Health)
                .. "/" .. math.floor(humanoid.MaxHealth)

            local ownCharacter = LP.Character
            local ownRoot = ownCharacter
                and ownCharacter:FindFirstChild("HumanoidRootPart")

            if ownRoot then
                local distance = (ownRoot.Position - root.Position).Magnitude
                data.distance.Text = "DIST: " .. math.floor(distance) .. " studs"
            else
                data.distance.Text = "DIST: --"
            end
        else
            data.info.Visible = false
        end
    end
end

