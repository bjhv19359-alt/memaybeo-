track(spectateButton.Activated:Connect(function()
    if not canActivate(spectateButton) then return end

    if spectateEnabled then
        stopSpectate()
    else
        spectatePanel.Visible = not spectatePanel.Visible
        if spectatePanel.Visible then
            refreshSpectateList()
        end
