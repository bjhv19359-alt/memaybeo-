local function track(connection)
    table.insert(connections, connection)
    return connection
end

local function setButtonState(button, text, isOn)
    button.Text = text
    button.TextColor3 = isOn and GREEN or RED
    button.BorderColor3 = isOn and GREEN or RED
end

local function makeButton(name, text, position)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.fromOffset(100, 34)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    button.BackgroundTransparency = 0.15
    button.BorderColor3 = GREEN
    button.BorderSizePixel = 1
    button.TextColor3 = GREEN
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.Active = true
    button.AutoButtonColor = false
    button.ZIndex = 10
    button.Parent = gui

    buttonStates[button] = {
        moved = false,
        suppressClick = false
    }

    track(button.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        activeDrag = {
            button = button,
            input = input,
            inputType = input.UserInputType,
            startInput = input.Position,
            startPosition = button.Position,
            moved = false
        }

        buttonStates[button].moved = false
    end))

    return button
end

local function moveDraggedButton(input, isTouchMove)
    local drag = activeDrag
    if not drag then return end

    if drag.inputType == Enum.UserInputType.MouseButton1 then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
    elseif drag.inputType == Enum.UserInputType.Touch then
        if not isTouchMove and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
    else
        return
    end

    local delta = input.Position - drag.startInput

    if delta.Magnitude >= 7 then
        drag.moved = true
        buttonStates[drag.button].moved = true
    end

    if not drag.moved then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    local button = drag.button
    local start = drag.startPosition

    local startX = start.X.Scale * viewport.X + start.X.Offset
    local startY = start.Y.Scale * viewport.Y + start.Y.Offset

    local x = math.clamp(
        startX + delta.X, 0,
        math.max(0, viewport.X - button.AbsoluteSize.X)
    )

    local y = math.clamp(
        startY + delta.Y, 0,
        math.max(0, viewport.Y - button.AbsoluteSize.Y)
    )

    button.Position = UDim2.fromOffset(x, y)
end

track(UserInputService.InputChanged:Connect(function(input)
    moveDraggedButton(input, false)
end))

track(UserInputService.TouchMoved:Connect(function(input)
    moveDraggedButton(input, true)
end))

track(UserInputService.InputEnded:Connect(function(input)
    local drag = activeDrag
    if not drag then return end

    local ended = input == drag.input
        or (
            drag.inputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1
        )

    if not ended then return end

    local button = drag.button
    local state = buttonStates[button]

    if state and drag.moved then
        state.suppressClick = true
        task.delay(0.25, function()
            if buttonStates[button] == state then
                state.suppressClick = false
                state.moved = false
            end
        end)
    elseif state then
        state.moved = false
    end

    activeDrag = nil
end))

local function canActivate(button)
    local state = buttonStates[button]
    if not state then return true end

    if state.suppressClick then
        state.suppressClick = false
        state.moved = false
        return false
    end

    if state.moved then
        state.moved = false
        return false
    end

    return true
end

