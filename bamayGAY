local function hideESP(data)
    data.box.Visible = false
    data.line.Visible = false
    data.info.Visible = false
end

local function removeESP(player)
    local data = espObjects[player]
    if data then
        data.box:Destroy()
        data.line:Destroy()
        data.info:Destroy()
        espObjects[player] = nil
    end
    selectedPlayers[player] = nil
end

local function refreshList(list, mode)
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") or child.Name == "EmptyLabel" then
            child:Destroy()
        end
    end

    local order = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            order += 1

            local isSelected = selectedPlayers[player] ~= false
            local row = Instance.new("TextButton")
            row.Name = "Player_" .. player.UserId
            row.Size = UDim2.new(1, -4, 0, 34)
            row.BackgroundColor3 = isSelected
                and Color3.fromRGB(18, 42, 18)
                or Color3.fromRGB(35, 20, 20)
            row.BorderColor3 = isSelected and GREEN or RED
            row.TextColor3 = isSelected and GREEN or WHITE
            row.BorderSizePixel = 1
            row.TextSize = 11
            row.Font = Enum.Font.GothamBold
            row.TextTruncate = Enum.TextTruncate.AtEnd
            row.LayoutOrder = order
            row.ZIndex = 22
            row.Parent = list

            if mode == "ESP" then
                row.Text = (isSelected and "[ON] " or "[OFF] ")
                    .. player.DisplayName .. " @" .. player.Name

                row.Activated:Connect(function()
                    selectedPlayers[player] = not (selectedPlayers[player] ~= false)
                    refreshList(list, "ESP")
                end)
            else
                row.Text = (spectateTarget == player and "[ĐANG XEM] " or "")
                    .. player.DisplayName .. " @" .. player.Name

                row.Activated:Connect(function()
                    local character = player.Character
                    local humanoid = character
                        and character:FindFirstChildOfClass("Humanoid")

                    if not humanoid or humanoid.Health <= 0 then
                        row.Text = "Người chơi chưa sẵn sàng"
                        return
                    end

                    if not spectateEnabled then
                        local ownCharacter = LP.Character
                        local ownHumanoid = ownCharacter
                            and ownCharacter:FindFirstChildOfClass("Humanoid")
                        local ownRoot = ownCharacter
                            and ownCharacter:FindFirstChild("HumanoidRootPart")

                        if not ownHumanoid or not ownRoot then
                            return
                        end

                        lockedCharacter = ownCharacter
                        lockedState = {
                            WalkSpeed = ownHumanoid.WalkSpeed,
                            JumpPower = ownHumanoid.JumpPower,
                            JumpHeight = ownHumanoid.JumpHeight,
                            AutoRotate = ownHumanoid.AutoRotate,
                            Anchored = ownRoot.Anchored
                        }

                        ownHumanoid.WalkSpeed = 0
                        ownHumanoid.JumpPower = 0
                        ownHumanoid.JumpHeight = 0
                        ownHumanoid.AutoRotate = false
                        ownRoot.Anchored = true
                    end

                    spectateEnabled = true
                    spectateTarget = player

                    local camera = workspace.CurrentCamera
                    if camera then
                        camera.CameraSubject = humanoid
                    end

                    setButtonState(spectateButton, "SPECTATE: ON", true)
                    refreshList(list, "SPECTATE")
                end)
            end
        end
    end

    if order == 0 then
        local empty = Instance.new("TextLabel")
        empty.Name = "EmptyLabel"
        empty.Size = UDim2.new(1, -4, 0, 36)
        empty.BackgroundTransparency = 1
        empty.Text = "Không có người chơi khác"
        empty.TextColor3 = WHITE
        empty.TextSize = 11
        empty.Font = Enum.Font.Gotham
        empty.ZIndex = 22
        empty.Parent = list
    end
end

refreshPlayerList = function()
    refreshList(playerList, "ESP")
end

refreshSpectateList = function()
    refreshList(spectateList, "SPECTATE")
end

local function restoreCharacter()
    if lockedCharacter and lockedCharacter.Parent and lockedState then
        local humanoid = lockedCharacter:FindFirstChildOfClass("Humanoid")
        local root = lockedCharacter:FindFirstChild("HumanoidRootPart")

        if humanoid then
            pcall(function()
                humanoid.WalkSpeed = lockedState.WalkSpeed
                humanoid.JumpPower = lockedState.JumpPower
                humanoid.JumpHeight = lockedState.JumpHeight
                humanoid.AutoRotate = lockedState.AutoRotate
            end)
        end

        if root then
            pcall(function()
                root.Anchored = lockedState.Anchored
            end)
        end
    end

    lockedCharacter = nil
    lockedState = nil
end

local function stopSpectate()
    spectateEnabled = false
    spectateTarget = nil

    local camera = workspace.CurrentCamera
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if camera and humanoid then
        camera.CameraSubject = humanoid
    end

    restoreCharacter()
    setButtonState(spectateButton, "SPECTATE", false)
    refreshSpectateList()
end

local function isCharacterPart(part)
    local ancestor = part.Parent

    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Model") then
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character == ancestor then
                    return true
                end
            end
        end
        ancestor = ancestor.Parent
    end

    return false
end

local function applyRayX(part)
    if not rayXEnabled or not part:IsA("BasePart") then return end
    if isCharacterPart(part) then return end

    if rayOriginal[part] == nil then
        rayOriginal[part] = part.LocalTransparencyModifier
    end

    pcall(function()
        part.LocalTransparencyModifier = 0.8
    end)
end

local function disableRayX()
    rayXEnabled = false

    for part, originalValue in pairs(rayOriginal) do
        if part and part.Parent then
            pcall(function()
                part.LocalTransparencyModifier = originalValue
            end)
        end
    end

    table.clear(rayOriginal)
    setButtonState(rayButton, "RAY-X: OFF", false)
end

local function enableRayX()
    rayXEnabled = true

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("BasePart") then
            applyRayX(object)
        end
    end

    setButtonState(rayButton, "RAY-X: ON", true)
end

track(workspace.DescendantAdded:Connect(function(object)
    if rayXEnabled and object:IsA("BasePart") then
        task.defer(function()
            if object.Parent then
                applyRayX(object)
            end
        end)
    end
end))

