    createESP(player)
end

track(Players.PlayerAdded:Connect(function(player)
    if player ~= LP then
        selectedPlayers[player] = true
        createESP(player)
        if espPanel.Visible then refreshPlayerList() end
        if spectatePanel.Visible then refreshSpectateList() end
    end
end))

track(Players.PlayerRemoving:Connect(function(player)
    removeESP(player)

    if spectateEnabled and spectateTarget == player then
        stopSpectate()
    end

    if espPanel.Visible then refreshPlayerList() end
    if spectatePanel.Visible then refreshSpectateList() end
end))

track(LP.CharacterAdded:Connect(function()
    task.wait(0.2)

    if spectateEnabled then
        local target = spectateTarget
        local humanoid = target and target.Character
            and target.Character:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.Health > 0 then
            local character = LP.Character
            local ownHumanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if ownHumanoid and root then
                lockedCharacter = character
                lockedState = {
                    WalkSpeed = ownHumanoid.WalkSpeed,
                    JumpPower = ownHumanoid.JumpPower,
                    JumpHeight = ownHumanoid.JumpHeight,
                    AutoRotate = ownHumanoid.AutoRotate,
                    Anchored = root.Anchored
                }

                ownHumanoid.WalkSpeed = 0
                ownHumanoid.JumpPower = 0
                ownHumanoid.JumpHeight = 0
                ownHumanoid.AutoRotate = false
                root.Anchored = true
            end

            if workspace.CurrentCamera then
                workspace.CurrentCamera.CameraSubject = humanoid
            end
        else
            stopSpectate()
        end
    else
        local humanoid = LP.Character
            and LP.Character:FindFirstChildOfClass("Humanoid")

        if humanoid and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = humanoid
        end
    end
end))

RunService:BindToRenderStep(
    RENDER_NAME,
    Enum.RenderPriority.Camera.Value + 1,
    function()
        local camera = workspace.CurrentCamera
        if not camera then return end

        local viewport = camera.ViewportSize
        local startPos = Vector2.new(viewport.X / 2, viewport.Y)

        local myCharacter = LP.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        for player, data in pairs(espObjects) do
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if not enabled or selectedPlayers[player] == false
                or not root or not humanoid or humanoid.Health <= 0 then
                hideESP(data)
                continue
            end

            local center, onScreen = camera:WorldToViewportPoint(root.Position)

            if not onScreen or center.Z <= 0
                or center.X < 0 or center.X > viewport.X
                or center.Y < 0 or center.Y > viewport.Y then
                hideESP(data)
                continue
            end

            local head = character:FindFirstChild("Head")
            local topY, bottomY

            if head then
                topY = camera:WorldToViewportPoint(
                    head.Position + Vector3.new(0, 0.5, 0)
                ).Y

                bottomY = camera:WorldToViewportPoint(
                    root.Position - Vector3.new(0, 3, 0)
                ).Y
            else
                local halfHeight = humanoid.HipHeight * 2 + 25
                topY = center.Y - halfHeight
                bottomY = center.Y + halfHeight
            end

            local boxHeight = math.max(20, bottomY - topY)
            local boxWidth = boxHeight * 0.48
            local boxX = center.X - boxWidth / 2
            local boxY = topY

            data.box.Position = UDim2.fromOffset(boxX, boxY)
            data.box.Size = UDim2.fromOffset(boxWidth, boxHeight)
            data.box.Visible = true

            local target = Vector2.new(center.X, center.Y)
            local delta = target - startPos
            local length = delta.Magnitude

            if length > 1 then
                data.line.Position = UDim2.fromOffset(
                    (startPos.X + target.X) / 2,
                    (startPos.Y + target.Y) / 2
                )
                data.line.Size = UDim2.fromOffset(1, length)
                data.line.Rotation = math.deg(math.atan2(delta.Y, delta.X)) - 90
                data.line.Visible = true
            else
                data.line.Visible = false
            end

            if infoEnabled then
                local infoWidth = 178
                local infoHeight = 76
                local infoX = boxX + boxWidth + 4

                if infoX + infoWidth > viewport.X then
                    infoX = boxX - infoWidth - 4
                end

                infoX = math.clamp(infoX, 0, math.max(0, viewport.X - infoWidth))
                local infoY = math.clamp(boxY, 0, math.max(0, viewport.Y - infoHeight))

                data.info.Position = UDim2.fromOffset(infoX, infoY)
                data.info.Visible = true
                data.displayName.Text = player.DisplayName
                data.username.Text = "@" .. player.Name

                local currentHP = math.floor(humanoid.Health + 0.5)
                local maxHP = math.floor(humanoid.MaxHealth + 0.5)
                data.hp.Text = "HP: " .. currentHP .. "/" .. maxHP
                data.hp.TextColor3 = humanoid.Health <= humanoid.MaxHealth * 0.25
                    and RED or GREEN

                local dist = 0
                if myRoot then
                    dist = math.floor((myRoot.Position - root.Position).Magnitude + 0.5)
                end

                data.distance.Text = "DIST: " .. dist .. " studs"
            else
                data.info.Visible = false
            end
        end

        if spectateEnabled then
            local target = spectateTarget
            local humanoid = target and target.Character
                and target.Character:FindFirstChildOfClass("Humanoid")

            if not target or not target.Parent or not humanoid or humanoid.Health <= 0 then
                stopSpectate()
            else
                if workspace.CurrentCamera
                    and workspace.CurrentCamera.CameraSubject ~= humanoid then
                    workspace.CurrentCamera.CameraSubject = humanoid
                end
            end
        end
    end
)

local function cleanup()
    pcall(function()
        RunService:UnbindFromRenderStep(RENDER_NAME)
    end)

    if rayXEnabled then
        disableRayX()
    end

    if spectateEnabled then
        stopSpectate()
    else
        restoreCharacter()
    end

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if gui then gui:Destroy() end
end

if script then
    pcall(function()
        script.Destroying:Connect(cleanup)
    end)
end
